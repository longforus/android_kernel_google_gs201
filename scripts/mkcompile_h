#!/bin/sh
# SPDX-License-Identifier: GPL-2.0

TARGET=$1
ARCH=$2
SMP=$3
PREEMPT=$4
PREEMPT_RT=$5
CC_VERSION="$6"
LD=$7

vecho() { [ "${quiet}" = "silent_" ] || echo "$@" ; }

# Do not expand names
set -f

# Fix the language to get consistent output
LC_ALL=C
export LC_ALL

if [ -z "$KBUILD_BUILD_VERSION" ]; then
	VERSION=$(cat .version 2>/dev/null || echo 1)
else
	VERSION=$KBUILD_BUILD_VERSION
fi

# if test -z "$KBUILD_BUILD_USER"; then
# 	LINUX_COMPILE_BY=$(whoami | sed 's/\\/\\\\/')
# else
# 	LINUX_COMPILE_BY=$KBUILD_BUILD_USER
# fi
LINUX_COMPILE_BY="android-build"   # 官方通常用这个
# if test -z "$KBUILD_BUILD_HOST"; then
# 	LINUX_COMPILE_HOST=`uname -n`
# else
# 	LINUX_COMPILE_HOST=$KBUILD_BUILD_HOST
# fi
LINUX_COMPILE_HOST="google.com"    # 或者是代码代号，如 "aruba"
# UTS_VERSION="#$VERSION"
UTS_VERSION="#1 SMP PREEMPT Wed Jan 22 00:00:00 UTC 2025"
CONFIG_FLAGS=""
if [ -n "$SMP" ] ; then CONFIG_FLAGS="SMP"; fi
if [ -n "$PREEMPT" ] ; then CONFIG_FLAGS="$CONFIG_FLAGS PREEMPT"; fi
if [ -n "$PREEMPT_RT" ] ; then CONFIG_FLAGS="$CONFIG_FLAGS PREEMPT_RT"; fi

# Truncate to maximum length
UTS_LEN=64
# UTS_VERSION 已包含固定标志与日期，不再追加构建参数或实际时间。
UTS_VERSION="$(printf '%s' "$UTS_VERSION" | cut -b -$UTS_LEN)"

# Generate a temporary compile.h

{ echo /\* This file is auto generated, version $VERSION \*/
  if [ -n "$CONFIG_FLAGS" ] ; then echo "/* $CONFIG_FLAGS */"; fi

  echo \#define UTS_MACHINE \"$ARCH\"

  echo \#define UTS_VERSION \"$UTS_VERSION\"

  printf '#define LINUX_COMPILE_BY "%s"\n' "$LINUX_COMPILE_BY"
  echo \#define LINUX_COMPILE_HOST \"$LINUX_COMPILE_HOST\"

  LD_VERSION=$($LD -v | head -n1 | sed 's/(compatible with [^)]*)//' \
		      | sed 's/[[:space:]]*$//')
  printf '#define LINUX_COMPILER "%s"\n' "$CC_VERSION, $LD_VERSION"
} > .tmpcompile

# Only replace the real compile.h if the new one is different,
# in order to preserve the timestamp and avoid unnecessary
# recompilations.
# 固定版本串也参与比较，确保增量构建能替换旧的重复拼接结果。
if [ -r "$TARGET" ] && cmp -s "$TARGET" .tmpcompile; then
   rm -f .tmpcompile
else
   vecho "  UPD     $TARGET"
   mv -f .tmpcompile $TARGET
fi
